{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/imports/upload", "destination": "/api/admin-import-upload" },
    { "source": "/api/admin/imports/preview", "destination": "/api/admin-import-preview" },
    { "source": "/api/admin/imports/:batchId/commit", "destination": "/api/admin-import-commit?batchId=:batchId" },
    { "source": "/api/admin/host-accounts/:id/send-access", "destination": "/api/admin-send-access?id=:id" },
    { "source": "/api/admin/allocations/:id", "destination": "/api/admin-allocation?id=:id" },
    { "source": "/api/portal/me", "destination": "/api/portal-me" },
    { "source": "/api/portal/fourballs/:id/players", "destination": "/api/portal-players?id=:id" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/host/:path*", "destination": "/host.html" }
  ],
  "functions": {
    "api/*.js": { "regions": ["dub1"] },
    "api/v1/**/*.js": { "regions": ["dub1"] }
  },
  "crons": [
    { "path": "/api/v1/cron-reminders", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow,noarchive" }
      ]
    },
    {
      "source": "/host",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/host-login(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/portal(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://glendower.co.za https://*.supabase.co; media-src 'self' https://glendower.co.za; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.supabase.co; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
