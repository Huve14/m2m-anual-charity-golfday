{
  "name": "m2m-charity-golf-registration",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "icons:generate": "node ./scripts/generate-m2m-icons.mjs",
    "db:generate": "drizzle-kit generate",
    "supabase:create-table": "node ./scripts/create-m2m-reg-table.mjs",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "supabase db lint --local --level warning",
    "supabase:test": "supabase test db supabase/tests/multi_event_golf_day.test.sql --local",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "ops:invite-admins": "node ./scripts/invite-operations-admins.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.17.0",
    "@supabase/supabase-js": "2.112.4",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "three": "0.184.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260829.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.7",
    "vite": "8.2.2",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
